<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.bios.HospedagemContratada"
             NavigationPage.HasNavigationBar="False" 
             BackgroundColor="{x:StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="Center">

        <Label Text="{Binding QuartoSelecionado.Descricao}"
               TextColor="{StaticResource Primary}"
               FontFamily="Caveat-Bold"
               FontSize="50"
               HorizontalTextAlignment="Center"/>

        <Frame Margin="10">
            <StackLayout  Orientation="Horizontal">
                <StackLayout BackgroundColor="Aqua" Orientation="Horizontal">
                    <HorizontalStackLayout BackgroundColor="Red"
                           HorizontalOptions="FillAndExpand">
                        <Label Text="Adultos: " />
                        <Label Text="{Binding QntAdultos}"
               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout BackgroundColor="Red"
                           HorizontalOptions="FillAndExpand">
                        <Label Text="Crianças: " />
                        <Label Text="{Binding QntCriancas}"
               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                </StackLayout>
        </Frame>

        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *, *" 
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Check-Out"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia"/>

                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckin, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor ="{StaticResource Primary}" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckout, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor ="{StaticResource Primary}" />
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia}"
                     TextColor ="{StaticResource Primary}"  />
            </Grid>
        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout HorizontalOptions="CenterAndExpand">

                <Label Text="Valor Total: " />

                <Label Text="{Binding ValorTotal, StringFormat='{}{0:C}'}" 
                       TextColor ="{StaticResource Primary}"/>

            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar"
               HorizontalOptions="Center"
               Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>